# ============================================
# Inscribed Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# CORS — allowed frontend origin
# Use * for development (allows all origins)
# Set to specific URL in production (e.g. https://your-app.com)
FRONTEND_URL=*

# Request / upload limits
MAX_FILE_SIZE_MB=50
BODY_LIMIT=50mb
UPLOAD_TIMEOUT_MS=120000

# Temp file directory (defaults to OS temp dir)
# TEMP_DIR=/tmp/docu-assistant

# Graceful shutdown timeout (ms)
# SHUTDOWN_TIMEOUT_MS=10000

# ============================================
# AI Provider Configuration
# ============================================
# Active provider: openai | gemini | claude
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# Fallback: try other providers if the primary one fails
# Set to true and list provider order
ENABLE_FALLBACK=false
FALLBACK_PROVIDERS=openai,gemini,claude

# AI generation defaults
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# AI safety limits
AI_TIMEOUT_MS=60000
AI_MAX_PROMPT_LENGTH=100000
AI_MAX_DOCUMENT_LENGTH=500000
AI_MAX_RETRIES=1

# ============================================
# AI API v2 — auth, limits, storage, retrieval
# ============================================
# Auth mode: off | monitor | enforce. Start at monitor: it checks and logs
# everything but blocks nothing. Switch to enforce only once the logs show
# most requests carry a valid app key and user id.
AUTH_MODE=monitor

# Comma-separated app keys. Several may be live at once so keys can rotate.
# The app ships one of these as EXPO_PUBLIC_AI_APP_KEY.
AI_APP_KEYS=

# RevenueCat entitlement check (server-side)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# Comma-separated RevenueCat user ids that skip the premium check (testers).
AUTH_ALLOWLIST_USER_IDS=

# Guards /switch-provider and /admin/auth-stats. Unset = those routes 404.
ADMIN_TOKEN=

# Rate limits (generous defaults; set RATE_LIMIT_ENABLED=false to disable)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_MIN=60
RATE_LIMIT_AI_PER_DAY=1000
RATE_LIMIT_IP_PER_MIN=180
RATE_LIMIT_EXTRACT_PER_HOUR=30

# Optional per-user daily token cap. Unset = no cap.
# DAILY_TOKEN_BUDGET_PER_USER=200000

# Persistent document storage. Unset = in-memory store (documents are then
# NOT shared between the two Render services).
DATABASE_URL=
RUN_MIGRATIONS=false
DOC_TTL_DAYS=7

# Embeddings: openai | gemini | voyage | none. Unset = auto-detect from the
# available API keys, falling back to keyword-only retrieval.
EMBEDDINGS_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# VOYAGE_API_KEY=

# Retrieval + long-document processing
RAG_CONTEXT_CHARS=16000
TRANSLATE_MAX_OUTPUT_CHARS=200000
XLSX_MAX_CELLS=50000

# ---- Other Third-party APIs ----

# Google Cloud TTS (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Azure Cognitive Services TTS (optional)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# AWS Polly TTS (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
